# API URL (Deployed AWS Backend URL)
# Example for AWS App Runner: https://xxxx.awsapprunner.com/uptime/api
# Example for AWS EC2/Custom Domain: https://api.yourdomain.com/uptime/api
VITE_API_BASE_URL=http://localhost:8000/uptime/api

# WebSocket URL (Deployed AWS WebSocket URL)
# Example for AWS App Runner: https://xxxx.awsapprunner.com/ws
# Example for AWS EC2/Custom Domain: https://api.yourdomain.com/ws
VITE_WS_URL=http://localhost:8000/ws
