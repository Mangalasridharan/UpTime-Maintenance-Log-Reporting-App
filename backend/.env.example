# =============================================================================
#  UpTime Maintenance - Backend Environment Configuration
# =============================================================================
#  Copy this file to `.env`, adjust the values, then run the backend.
#  The backend reads this file automatically (spring-dotenv).
# =============================================================================

# ---------- Database source ----------
# Switch the database by changing DB_PROFILE:
#   local     -> Local PostgreSQL (default, works out of the box with docker-compose)
#   supabase  -> Supabase hosted PostgreSQL
#   rds       -> Amazon RDS PostgreSQL
DB_PROFILE=local

# ---------- Server ----------
PORT=8000

# ---------- Database: Local / Docker / CI ----------
# Used by the `local` profile (and by docker-compose / GitHub Actions).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Uptime-Maintenance-log-reporting-app
DB_USER=postgres
DB_PASSWORD=mangal@123

# ---------- Database: Supabase (set DB_PROFILE=supabase) ----------
# DB_HOST=db.<your-project-ref>.supabase.co
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=<your-supabase-db-password>
# Supabase connections use SSL automatically (sslmode=require).

# ---------- Database: Amazon RDS (set DB_PROFILE=rds) ----------
# DB_HOST=<your-instance>.<region>.rds.amazonaws.com
# DB_NAME=<your-rds-db-name>
# DB_USER=<your-rds-username>
# DB_PASSWORD=<your-rds-password>

# ---------- Full JDBC override (optional, any profile) ----------
# Set SPRING_DATASOURCE_URL to take complete control of the connection string.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<username>
# SPRING_DATASOURCE_PASSWORD=<password>

# ---------- JWT ----------
JWT_SECRET=VGhpc0lzQVN1cGVyU2VjcmV0S2V5Rm9ySldUU3ByaW5nQm9vdA==
JWT_EXPIRATION=1800000

# ---------- RabbitMQ ----------
# Defaults to localhost:5672 with guest/guest (matches docker-compose rabbitmq service).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- Initial Admin Employee Credentials ----------
ADMIN_EMPLOYEE_NAME=mangal
ADMIN_EMPLOYEE_PASSWORD=mangal@123